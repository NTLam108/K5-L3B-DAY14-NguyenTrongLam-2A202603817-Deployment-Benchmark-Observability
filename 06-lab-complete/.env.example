# ============================================================
# Biến môi trường của agent. KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env  rồi điền giá trị (.env nằm trong .gitignore)
# Trên Railway / Render: đặt các biến này trong phần Variables / Environment.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security — bắt buộc. Để trống thì mọi request /ask bị 401.
# Tạo key ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Redis — docker-compose.yml tự đặt redis://redis:6379/0 cho service agent
REDIS_URL=redis://localhost:6379/0

# Rate limiting: số request / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard: ngân sách LLM mỗi ngày (USD, reset 00:00 UTC)
DAILY_BUDGET_USD=1.0
